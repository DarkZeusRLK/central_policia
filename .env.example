# --- Chamadas de Curso (sistema de voz + compartilhamento de tela na intranet) ---

# Cargos de instrutor por facção (aceitam lista separada por vírgula, ponto-e-vírgula ou
# quebra de linha, e também o formato de menção do Discord "<@&ID_DO_CARGO>").
# Quem tiver qualquer um destes cargos pode mutar/desmutar, silenciar, desconectar e mover
# outros participantes entre salas, mas NÃO pode criar/apagar/renomear salas.
INSTRUTOR_PCERJ_ROLE_ID=
INSTRUTOR_PMERJ_ROLE_ID=
INSTRUTOR_PRF_ROLE_ID=

# Cargos de administrador das chamadas (mesmo formato acima). Além de tudo que um
# instrutor pode fazer, administradores criam, apagam e renomeiam salas, e definem o
# limite de membros de cada uma. Os cargos/IDs já configurados em OWNER e COMANDO_GERAL
# (usados no resto do site) automaticamente contam como administrador aqui também.
VOICE_ADMIN_ROLE_IDS=

# Chave de API do Ably (plano gratuito: https://ably.com) usada só no servidor para
# emitir tokens de sinalização e publicar eventos de moderação confiáveis. NUNCA é
# enviada ao navegador.
ABLY_API_KEY=

# Servidor TURN usado quando a conexão direta entre dois navegadores falha (rede
# restrita/corporativa). Se não configurar, o sistema usa por padrão o TURN público e
# gratuito do Open Relay Project (openrelay.metered.ca, ~20GB/mês) — para mais
# capacidade, crie uma conta gratuita em https://www.metered.ca/tools/openrelay/ e
# coloque suas próprias credenciais aqui.
TURN_URLS=turn:openrelay.metered.ca:80,turns:openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# Duração do token de sinalização em segundos (padrão 600 = 10 min). Também é o prazo
# máximo para um "desconectar" forçado realmente derrubar um participante que ignore o
# aviso imediato — quanto menor, mais rápido o corte garantido, mas mais chamadas de
# renovação de token.
VOICE_TOKEN_TTL_SECONDS=600

# Quanto tempo (segundos) alguém fica impedido de reentrar numa sala depois de ser
# desconectado por um instrutor/admin (padrão 30).
VOICE_KICK_COOLDOWN_SECONDS=30

# --- Variáveis já usadas pelo restante do site (não específicas desta funcionalidade,
# listadas aqui só como referência de que também precisam estar configuradas) ---
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# OWNER=
# COMANDO_GERAL=
# MONGODB_URI=
# MONGODB_DB=
